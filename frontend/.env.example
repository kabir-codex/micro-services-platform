# Copy to .env.local and adjust if you run the Vite dev server with
# backends on non-default ports. These are build-time variables: Vite bakes
# them into the bundle at build time, so they take effect via the Docker build
# args in docker-compose.yml and the CI workflow — not at runtime.

# Orders API (backend-node, Express)
VITE_ORDERS_API_URL=http://localhost:4000

# Catalog API (backend-java, Spring Boot)
VITE_CATALOG_API_URL=http://localhost:8080